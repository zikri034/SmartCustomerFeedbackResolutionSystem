# Copy this to `.env` and fill in your credentials
# cp .env.example .env

# ── Server ────────────────────────────────────────────
PORT=3001
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:5173

# ── PostgreSQL ─────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=smart_feedback
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# ── Google Gemini (Emotion Analysis + Auto-Resolution) ─
# Dapatkan API key gratis: https://aistudio.google.com/app/apikey
# Digunakan untuk KEDUA fitur: deteksi emosi DAN auto-reply
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=20000
