# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:5173

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=smart_feedback
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# ── IBM Watson NLU ────────────────────────────────────────────────────────────
# Get from IBM Cloud > Natural Language Understanding > Service credentials
WATSON_NLU_API_KEY=your_watson_api_key_here
WATSON_NLU_URL=https://api.us-south.natural-language-understanding.watson.cloud.ibm.com

# ── Ollama (local) ────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# OLLAMA_MODEL=qwen3       # alternative: Qwen 3 8B
OLLAMA_TIMEOUT=30000
